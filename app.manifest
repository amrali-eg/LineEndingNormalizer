<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.5.0.0" name="LineEndingNormalizer.app"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        Lets Win32 file APIs called directly via P/Invoke (see
        LosslessFileWriter.ReplaceFileNative) use paths beyond MAX_PATH on
        systems where long paths are enabled. Regular .NET file I/O
        (FileStream, File.*, Directory.*) already handles this on its own;
        this specifically covers the raw Win32 call this app makes.
      -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
